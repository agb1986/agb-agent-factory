# Copy to .env (git-ignored) and fill in. Compose and `docker run --env-file .env` read it at run
# time; nothing here is built into the image. Never commit a filled-in copy.
#
# Plain KEY=value lines, no quotes: an env file passed to docker keeps quotes as part of the value.

# Required by `factory review`. Create it in the Anthropic Console (API keys) for the workspace
# this host should bill to. On this machine the same key is stored in `agb sys secrets`; on the
# CasaOS host paste it here once and `chmod 600 .env`. To rotate, see docs/deploy.md.
ANTHROPIC_API_KEY=

# Optional. The Jev key for the triage step. Leave it empty and run reviews with --no-triage
# (or pass it through the API as no_triage) until a key exists. Issued in the Typesafe dashboard;
# `agb sys secrets` holds it on the machine that already has one.
TYPESAFE_API_KEY=

# Where the compose file looks for the repositories to review, mounted read-only at /repos.
# REVIEW_REPOS=/srv/repos

# Not needed for the stock setup: the image and compose.yaml already set
# FACTORY_TRACE_DB=/app/data/traces.duckdb and TYPESAFE_LOG_LEVEL=warning.
